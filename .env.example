# --- Server ---
PORT=3000
NODE_ENV=development

# --- Postgres (needs the pgvector extension) ---
# LEAVE EMPTY to run with embedded Postgres (PGlite) stored in ./data/pgdata.
# Real Postgres, pick one:
#   docker compose:  postgres://docint:docint@localhost:5432/docint
#   Neon (pooled connection string, keep the sslmode):
#                    postgres://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# --- Redis (cache + job queue) ---
# LEAVE EMPTY to run without Redis: in-memory cache, ingestion in-process.
# Real Redis, pick one:
#   docker compose:  redis://localhost:6379
#   Upstash — must be the rediss:// TCP URL, NOT the REST/HTTPS one, because
#             BullMQ speaks the Redis wire protocol:
#                    rediss://default:PASSWORD@REGION.upstash.io:6379
REDIS_URL=

# --- Auth ---
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# --- Answer generation: set ONE of these ---
# Gemini has a free tier (no card needed): https://aistudio.google.com -> Get API key
GEMINI_API_KEY=
# Anthropic (Claude) is paid: https://console.anthropic.com
ANTHROPIC_API_KEY=
# When both are set, Anthropic is preferred; force with ANSWER_PROVIDER=gemini
# ANSWER_PROVIDER=
# GEMINI_MODEL=gemini-2.5-flash

# --- Voyage AI (embeddings) ---
# Anthropic does not serve an embeddings endpoint; Voyage is their recommended
# embedding provider. Get a key at https://voyageai.com
VOYAGE_API_KEY=pa-...
EMBEDDING_MODEL=voyage-3
EMBEDDING_DIM=1024

# --- Limits ---
MAX_UPLOAD_MB=25
ASK_RATE_LIMIT_PER_HOUR=60
LOGIN_RATE_LIMIT_PER_15MIN=10
# One-click demo accounts created per IP per hour.
DEMO_RATE_LIMIT_PER_HOUR=10

# --- Timeouts (optional; defaults suit hosted Postgres/Redis) ---
# DB_CONNECT_TIMEOUT_MS=10000
# HEALTH_PROBE_TIMEOUT_MS=8000
# REDIS_COMMAND_TIMEOUT_MS=3000
